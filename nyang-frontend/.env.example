# Set through Sites production environment configuration. Never commit actual account values.
NYANG_ADMIN_EMAIL=

# Server-only PBKDF2 demo password hash; configured through Sites secrets.
NYANG_DEMO_PASSWORD_HASH=

# main 브랜치 Supabase 백엔드(chat 함수: FAQ·문서 검색·AI 답변) 연결. 비워 두면 기존 샘플 FAQ로만 답합니다.
# URL과 publishable key는 Supabase 대시보드 > Project Settings > API Keys 에서 확인합니다.
KNOWLY_SUPABASE_URL=
KNOWLY_SUPABASE_KEY=
# 냥대리 서버가 대신 질문할 Knowly 직원 계정 (관리자 화면에서 발급, 예: <아이디>@knowly.local).
# 비밀번호는 Sites secrets로만 설정하고 커밋하지 않습니다.
KNOWLY_LOGIN_EMAIL=
KNOWLY_LOGIN_PASSWORD=
# 담당자 화면(FAQ·문서·사용자·검색 모델 설정·통계)이 대신 사용할 Knowly 관리자 계정. 비우면 기존 샘플 관리자 화면을 보여줍니다.
KNOWLY_ADMIN_EMAIL=
KNOWLY_ADMIN_PASSWORD=
